# Overlay that turns the radio and MQTT on. Combine it with the real defaults:
#
#   idf.py -D SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.net" build
#
# Kept separate because CONFIG_SPA_HMI_NET is off in sdkconfig.defaults on
# purpose — the shipping panel runs the tub and must not acquire a dependency on
# a network to do it. This file is how you build the networking variant without
# editing that decision.
#
# No esp_hosted settings here, and that is a finding rather than an omission:
# every SDIO value the transport needs already matches Guition's own working
# build for this exact carrier (CONFIG_BOARD_TYPE_GUITION_JC4880P443=y in their
# xiaozhi demo) by default — CMD 19, CLK 18, D0-D3 14/15/16/17, slave reset 54,
# slot 1, 4-bit, 40 MHz, slave target esp32c6. Verified key by key, and then
# confirmed live: the C6 identified itself and scanned on the first boot.
CONFIG_SPA_HMI_NET=y
CONFIG_SPA_HMI_MQTT=y
CONFIG_SPA_HMI_BLE_PROV=y

# BLE, for provisioning. The P4 has no radio: the NimBLE HOST runs here and the
# CONTROLLER stays on the C6, reached over the same internal SDIO bus that
# carries WiFi. Hence a disabled local controller and the VHCI transport - this
# combination is esp_hosted's own host_nimble_bleprph_host_only_vhci example,
# which is the only reference for this topology; the vendor's demos do not
# enable BT at all.
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_DISABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_TRANSPORT_UART=n
CONFIG_ESP_HOSTED_ENABLE_BT_NIMBLE=y
CONFIG_ESP_HOSTED_NIMBLE_HCI_VHCI=y

# The timezone IS set here, unlike the credentials below. It is not a secret, and
# the Kconfig default is empty on purpose — an unset zone keeps the clock at
# "--:--" rather than showing UTC, because a wrong time on a wall panel is worse
# than no time. Leaving it unset here too would mean every clean rebuild quietly
# lost the clock. Change it for a tub anywhere else; the forms are listed in the
# Kconfig help.
CONFIG_SPA_HMI_TZ="EST5EDT,M3.2.0,M11.1.0"

# Credentials and broker are deliberately NOT set here. Put them in
# your local sdkconfig via menuconfig (it is gitignored) so no secret is ever
# committed:
#   menuconfig -> Spa HMI -> WiFi SSID / WiFi password
#                            Broker URI / username / password / device id
